# Cloudflare Pages / Workers static assets headers.
# NOTE: _headers is STATIC — it cannot run logic or check a secret.
# Maintenance gating + admin key is done in js/worker.js (env vars).
# This file only pins sane defaults.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: no-referrer-when-downgrade
  Permissions-Policy: geolocation=(), microphone=(), camera=()

/.git/*
  X-Robots-Tag: noindex
  Cache-Control: no-store

/.gitignore
  X-Robots-Tag: noindex

/maintenance.html
  Cache-Control: no-store
  X-Robots-Tag: noindex

/about.html
  Cache-Control: no-store

/privacy.html
  X-Robots-Tag: noindex, nofollow

/tos.html
  X-Robots-Tag: noindex, nofollow

/data-deletion.html
  X-Robots-Tag: noindex, nofollow

/plans.html
  Cache-Control: no-store

/403.html
  Cache-Control: no-store
  X-Robots-Tag: noindex

/404.html
  Cache-Control: no-store
  X-Robots-Tag: noindex

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

/image/og-image.jpg
  Cache-Control: public, max-age=86400

# SLK = teks; content-type ini bikin Cloudflare kompres (br) -> download jauh lebih cepat
/script/*.slk
  Content-Type: text/plain
